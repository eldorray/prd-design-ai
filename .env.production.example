# Production environment template.
#
# Salin ke .env DI SERVER, lalu isi setiap nilai bertanda GANTI.
# Jangan menyalin .env dari mesin lokal: APP_KEY harus dibangkitkan ulang
# di server, dan default lokal akan membocorkan API key lewat halaman error.
#
# Setelah terisi, jalankan: php artisan deploy:check

APP_NAME="AI PRD Generator"
APP_ENV=production
APP_KEY=                                  # GANTI — php artisan key:generate
APP_DEBUG=false
APP_URL=https://domain-anda.com           # GANTI

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# SQLite tidak sanggup melayani tiga stream SSE paralel sambil menulis
# session dan cache; lihat docs/DEPLOY.md bagian 2.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=                              # GANTI
DB_USERNAME=                              # GANTI
DB_PASSWORD=                              # GANTI

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Selama blok ini masih "log", reset password tidak terkirim ke mana pun dan
# verifikasi email harus tetap nonaktif di config/fortify.php.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

DEEPSEEK_API_KEY=                         # GANTI bila provider ini dipakai
DEEPSEEK_BASE_URL=https://api.deepseek.com

GEMINI_API_KEY=                           # GANTI bila provider ini dipakai
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

TOKENROUTER_API_KEY=                      # GANTI bila provider ini dipakai
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1

# Opsional: menyuntikkan dokumentasi library ke prompt desain.
CONTEXT7_API_KEY=

VITE_APP_NAME="${APP_NAME}"
